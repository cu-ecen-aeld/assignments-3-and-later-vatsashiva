#!/bin/sh

module=aesdchar
device=aesdchar
mode="664"

case "$1" in
    start|"")
        echo "Loading ${module}"

        if [ -e /lib/modules/$(uname -r)/extra/${module}.ko ]; then
            modprobe ${module} || exit 1
        else
            modprobe ${module} || exit 1
        fi

        major=$(awk "\$2==\"${module}\" {print \$1}" /proc/devices)

        if [ -z "$major" ]; then
            echo "Failed to find major number for ${module}"
            exit 1
        fi

        rm -f /dev/${device}
        mknod /dev/${device} c ${major} 0
        chmod ${mode} /dev/${device}
        ;;

    stop)
        echo "Unloading ${module}"
        rm -f /dev/${device}
        rmmod ${module} || true
        ;;

    restart)
        "$0" stop
        "$0" start
        ;;

    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
